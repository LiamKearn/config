let mapleader=' '

:set idearefactormode=keep
:set ignorecase smartcase
:set nohlsearch
:set incsearch
:set scrolloff=8
:set sidescrolloff=16
:nnoremap ]d :action GotoNextError<CR>
:nnoremap [d :action GotoPreviousError<CR>
